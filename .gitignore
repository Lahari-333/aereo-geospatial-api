# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables
.env
.env.*
!.env.example

# IDE and editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# Testing and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Uploaded and processed data (preserving directory structure via .gitkeep)
uploads/*
!uploads/.gitkeep
processed/*
!processed/.gitkeep

# Operating system files
.DS_Store
Thumbs.db

# Local database files
*.db
*.sqlite
*.sqlite3
